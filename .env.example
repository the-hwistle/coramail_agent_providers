# CoRA Mail provider development environment.
# Copy to .env for local development only. Do not put production secrets here.

CORAMAIL_DEV_HOST=127.0.0.1
CORAMAIL_DEV_PORT=8030

CORAMAIL_POSTGRES_DB=coramail_providers
CORAMAIL_POSTGRES_USER=coramail
CORAMAIL_POSTGRES_PASSWORD=coramail
CORAMAIL_POSTGRES_PORT=55452
CORAMAIL_DATABASE_URL=postgresql://coramail:coramail@127.0.0.1:55452/coramail_providers

CORAMAIL_QDRANT_HTTP_PORT=6653
CORAMAIL_QDRANT_GRPC_PORT=6654
CORAMAIL_QDRANT_URL=http://127.0.0.1:6653
CORAMAIL_QDRANT_CASE_COLLECTION=coramail_cases_providers_dev
CORAMAIL_QDRANT_VECTOR_SIZE=768

CORAMAIL_OLLAMA_PORT=11456
CORAMAIL_CONTAINER_LLM_BASE_URL=http://ollama:11434/v1
CORAMAIL_LLM_BASE_URL=http://127.0.0.1:11456/v1
CORAMAIL_LLM_PROVIDER=ollama
CORAMAIL_TEXT_MODEL=llama3.2:latest
CORAMAIL_CHAT_TEXT_MODEL=
CORAMAIL_VISION_MODEL=qwen3-vl:2b
CORAMAIL_EMBEDDING_MODEL=nomic-embed-text:latest

CORAMAIL_DEMO_MODE=false
CORAMAIL_DEMO_SOURCE=postgres
CORAMAIL_LOCAL_DEV_DEFAULTS=true
CORAMAIL_DEV_SEED_DEMO=true

CORAMAIL_MAIL_PROVIDER=gmail
GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_SEND_TOKEN_JSON=

CORAMAIL_NAVER_IMAP_HOST=imap.naver.com
CORAMAIL_NAVER_IMAP_PORT=993
CORAMAIL_NAVER_SMTP_HOST=smtp.naver.com
CORAMAIL_NAVER_SMTP_PORT=587
CORAMAIL_NAVER_MAIL_ADDRESS=
CORAMAIL_NAVER_IMAP_USERNAME=
CORAMAIL_NAVER_APP_PASSWORD=
CORAMAIL_NAVER_MAX_RESULTS=0

CORAMAIL_HIWORKS_POP3_HOST=pop3s.hiworks.com
CORAMAIL_HIWORKS_POP3_PORT=995
CORAMAIL_HIWORKS_SMTP_HOST=smtps.hiworks.com
CORAMAIL_HIWORKS_SMTP_PORT=465
CORAMAIL_HIWORKS_MAIL_ADDRESS=
CORAMAIL_HIWORKS_POP3_USERNAME=
CORAMAIL_HIWORKS_APP_PASSWORD=
CORAMAIL_HIWORKS_MAX_RESULTS=0
