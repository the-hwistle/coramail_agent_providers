# CoRA Mail Naver feasibility sandbox.
# Copy this file to config/naver-feasibility.env and keep real secrets out of Git.
# Infrastructure is intentionally separate from the Gmail dev stack:
# web 8010, Postgres 55432, Qdrant 6633/6634, Ollama 11436,
# runtime data/runtime/naver_feasibility, Docker volumes coramail_agent_providers_naver_*.

COMPOSE_PROJECT_NAME=coramail-agent-providers-naver

CORAMAIL_ENV_FILE=/app/config/naver-feasibility.env
CORAMAIL_MAIL_PROVIDER=naver
CORAMAIL_RUNTIME_DIR=data/runtime/naver_feasibility

CORAMAIL_DEMO_MODE=false
CORAMAIL_DEMO_SOURCE=postgres
CORAMAIL_LOCAL_DEV_DEFAULTS=false
CORAMAIL_AUTH_ENABLED=true
CORAMAIL_AUTH_USERNAME=admin
CORAMAIL_AUTH_PASSWORD=coramail
CORAMAIL_AUTH_SECRET=replace-with-random-secret
CORAMAIL_AUTH_SESSION_SECONDS=28800

CORAMAIL_DEV_HOST=127.0.0.1
CORAMAIL_DEV_PORT=8010

CORAMAIL_POSTGRES_DB=coramail_naver_feasibility
CORAMAIL_POSTGRES_USER=coramail
CORAMAIL_POSTGRES_PASSWORD=coramail
CORAMAIL_POSTGRES_PORT=55432
CORAMAIL_DATABASE_URL=postgresql://coramail:coramail@127.0.0.1:55432/coramail_naver_feasibility

CORAMAIL_QDRANT_HTTP_PORT=6633
CORAMAIL_QDRANT_GRPC_PORT=6634
CORAMAIL_QDRANT_URL=http://127.0.0.1:6633
CORAMAIL_QDRANT_CASE_COLLECTION=coramail_cases_naver_feasibility
CORAMAIL_QDRANT_VECTOR_SIZE=768

CORAMAIL_LLM_PROVIDER=ollama
CORAMAIL_CONTAINER_LLM_BASE_URL=http://ollama:11434/v1
CORAMAIL_OLLAMA_PORT=11436
CORAMAIL_TEXT_MODEL=llama3.2:latest
CORAMAIL_CHAT_TEXT_MODEL=
CORAMAIL_VISION_MODEL=qwen3-vl:2b
CORAMAIL_EMBEDDING_MODEL=nomic-embed-text:latest
CORAMAIL_LLM_MAX_CONCURRENCY=2
CORAMAIL_TEXT_LLM_MAX_CONCURRENCY=2
CORAMAIL_VISION_LLM_MAX_CONCURRENCY=1
CORAMAIL_EMBEDDING_LLM_MAX_CONCURRENCY=4

GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_SEND_TOKEN_JSON=

CORAMAIL_NAVER_IMAP_HOST=imap.naver.com
CORAMAIL_NAVER_IMAP_PORT=993
CORAMAIL_NAVER_SMTP_HOST=smtp.naver.com
CORAMAIL_NAVER_SMTP_PORT=587
CORAMAIL_NAVER_MAIL_ADDRESS=
CORAMAIL_NAVER_IMAP_USERNAME=
CORAMAIL_NAVER_APP_PASSWORD=
# 0/all/unlimited syncs the full mailbox. Set a positive number for bounded live probes.
CORAMAIL_NAVER_MAX_RESULTS=0
