# CoRA Mail Hiworks feasibility sandbox.
# Copy this file to config/hiworks-feasibility.env and keep real secrets out of Git.
# Infrastructure is intentionally separate from the Gmail dev stack:
# web 8020, Postgres 55442, Qdrant 6643/6644, Ollama 11446,
# runtime data/runtime/hiworks_feasibility, Docker volumes coramail_agent_hiworks_feasibility_*.

COMPOSE_PROJECT_NAME=coramail-agent-hiworks-feasibility

CORAMAIL_ENV_FILE=/app/config/hiworks-feasibility.env
CORAMAIL_MAIL_PROVIDER=hiworks
CORAMAIL_RUNTIME_DIR=data/runtime/hiworks_feasibility

CORAMAIL_DEMO_MODE=false
CORAMAIL_DEMO_SOURCE=postgres
CORAMAIL_LOCAL_DEV_DEFAULTS=false
CORAMAIL_AUTH_ENABLED=true
CORAMAIL_AUTH_USERNAME=admin
CORAMAIL_AUTH_PASSWORD=coramail
CORAMAIL_AUTH_SECRET=replace-with-random-secret
CORAMAIL_AUTH_SESSION_SECONDS=28800

CORAMAIL_DEV_HOST=127.0.0.1
CORAMAIL_DEV_PORT=8020

CORAMAIL_POSTGRES_DB=coramail_hiworks_feasibility
CORAMAIL_POSTGRES_USER=coramail
CORAMAIL_POSTGRES_PASSWORD=coramail
CORAMAIL_POSTGRES_PORT=55442
CORAMAIL_DATABASE_URL=postgresql://coramail:coramail@127.0.0.1:55442/coramail_hiworks_feasibility

CORAMAIL_QDRANT_HTTP_PORT=6643
CORAMAIL_QDRANT_GRPC_PORT=6644
CORAMAIL_QDRANT_URL=http://127.0.0.1:6643
CORAMAIL_QDRANT_CASE_COLLECTION=coramail_cases_hiworks_feasibility
CORAMAIL_QDRANT_VECTOR_SIZE=768

CORAMAIL_LLM_PROVIDER=ollama
CORAMAIL_CONTAINER_LLM_BASE_URL=http://ollama:11434/v1
CORAMAIL_OLLAMA_PORT=11446
CORAMAIL_TEXT_MODEL=llama3.2:latest
CORAMAIL_CHAT_TEXT_MODEL=
CORAMAIL_VISION_MODEL=qwen3-vl:2b
CORAMAIL_EMBEDDING_MODEL=nomic-embed-text:latest
CORAMAIL_LLM_MAX_CONCURRENCY=2
CORAMAIL_TEXT_LLM_MAX_CONCURRENCY=2
CORAMAIL_VISION_LLM_MAX_CONCURRENCY=1
CORAMAIL_EMBEDDING_LLM_MAX_CONCURRENCY=4

GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_SEND_TOKEN_JSON=

CORAMAIL_HIWORKS_POP3_HOST=pop3s.hiworks.com
CORAMAIL_HIWORKS_POP3_PORT=995
CORAMAIL_HIWORKS_SMTP_HOST=smtps.hiworks.com
CORAMAIL_HIWORKS_SMTP_PORT=465
CORAMAIL_HIWORKS_MAIL_ADDRESS=
CORAMAIL_HIWORKS_POP3_USERNAME=
CORAMAIL_HIWORKS_APP_PASSWORD=
# 0/all/unlimited syncs every message POP3 exposes. Set a positive number for bounded live probes.
CORAMAIL_HIWORKS_MAX_RESULTS=0
