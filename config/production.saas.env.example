# CoRA Mail Cloud Beta environment template.
# Copy to config/production.env or the deployment secret store.
# Replace every placeholder before running scripts/prod_check.sh.

CORAMAIL_WEB_IMAGE=registry.internal/coramail-agent:replace-with-tested-tag
CORAMAIL_BETA_BASE_URL=https://replace-with-beta-host.example.com
CORAMAIL_BETA_PUBLIC=true
CORAMAIL_BETA_HOST=replace-with-beta-host.example.com
CORAMAIL_WEB_BIND=127.0.0.1
CORAMAIL_WEB_PORT=8000
CORAMAIL_CADDY_IMAGE=caddy:2.8.4-alpine
CORAMAIL_EDGE_HTTP_BIND=0.0.0.0
CORAMAIL_EDGE_HTTP_PORT=80
CORAMAIL_EDGE_HTTPS_BIND=0.0.0.0
CORAMAIL_EDGE_HTTPS_PORT=443
CORAMAIL_PROD_BACKUP_DIR=backups/production

CORAMAIL_DEMO_MODE=false
CORAMAIL_LOCAL_DEV_DEFAULTS=false
CORAMAIL_DEV_SEED_DEMO=false
CORAMAIL_DEPLOYMENT_MODE=saas

CORAMAIL_AUTH_ENABLED=true
CORAMAIL_AUTH_USERNAME=replace-with-admin-login
CORAMAIL_AUTH_PASSWORD=replace-with-random-password
CORAMAIL_AUTH_SECRET=replace-with-at-least-32-random-characters
CORAMAIL_AUTH_COOKIE_SECURE=true
CORAMAIL_AUTH_SESSION_SECONDS=28800

CORAMAIL_MAIL_PROVIDER=setup

CORAMAIL_POSTGRES_IMAGE=postgres:17
CORAMAIL_POSTGRES_DB=coramail
CORAMAIL_POSTGRES_USER=coramail_app
CORAMAIL_POSTGRES_PASSWORD=replace-with-random-postgres-password
CORAMAIL_DATABASE_URL=postgresql://coramail_app:replace-with-random-postgres-password@postgres:5432/coramail

CORAMAIL_QDRANT_IMAGE=qdrant/qdrant:v1.15.4
CORAMAIL_QDRANT_URL=http://qdrant:6333
CORAMAIL_QDRANT_CASE_COLLECTION=coramail_cases_saas_beta
CORAMAIL_QDRANT_VECTOR_SIZE=768
CORAMAIL_QDRANT_API_KEY=

CORAMAIL_LLM_PROVIDER=vllm
CORAMAIL_LLM_RUNTIME=managed
CORAMAIL_EXTERNAL_LLM_APPROVED=false
CORAMAIL_LLM_BASE_URL=https://llm-gateway.cora.internal/v1
CORAMAIL_TEXT_MODEL=replace-with-managed-text-model
CORAMAIL_CHAT_TEXT_MODEL=replace-with-managed-chat-model
CORAMAIL_VISION_MODEL=replace-with-managed-vision-model
CORAMAIL_EMBEDDING_MODEL=replace-with-managed-embedding-model
CORAMAIL_LLM_MAX_CONCURRENCY=4
CORAMAIL_TEXT_LLM_MAX_CONCURRENCY=4
CORAMAIL_VISION_LLM_MAX_CONCURRENCY=2
CORAMAIL_EMBEDDING_LLM_MAX_CONCURRENCY=8
CORAMAIL_LLM_MAX_OUTPUT_TOKENS=1024

CORAMAIL_PADDLEOCR_ENABLED=auto
CORAMAIL_PADDLEOCR_MODE=auto
CORAMAIL_PADDLEOCR_DEVICE=gpu
CORAMAIL_PADDLEOCR_DOC_ORIENTATION=false
CORAMAIL_PADDLEOCR_DOC_UNWARPING=false
CORAMAIL_PADDLEOCR_TEXTLINE_ORIENTATION=false
CORAMAIL_PADDLEOCR_TABLE_ORIENTATION=false
CORAMAIL_PADDLEOCR_MKLDNN=false
PADDLE_PDX_CACHE_HOME=/tmp/coramail-paddlex-cache

GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_SEND_TOKEN_JSON=

CORAMAIL_NAVER_IMAP_HOST=imap.naver.com
CORAMAIL_NAVER_IMAP_PORT=993
CORAMAIL_NAVER_SMTP_HOST=smtp.naver.com
CORAMAIL_NAVER_SMTP_PORT=587
CORAMAIL_NAVER_MAIL_ADDRESS=
CORAMAIL_NAVER_IMAP_USERNAME=
CORAMAIL_NAVER_APP_PASSWORD=
CORAMAIL_NAVER_MAX_RESULTS=0

CORAMAIL_HIWORKS_POP3_HOST=pop3s.hiworks.com
CORAMAIL_HIWORKS_POP3_PORT=995
CORAMAIL_HIWORKS_SMTP_HOST=smtps.hiworks.com
CORAMAIL_HIWORKS_SMTP_PORT=465
CORAMAIL_HIWORKS_MAIL_ADDRESS=
CORAMAIL_HIWORKS_POP3_USERNAME=
CORAMAIL_HIWORKS_APP_PASSWORD=
CORAMAIL_HIWORKS_MAX_RESULTS=0
